# Copy to .env.local and fill in. Only these public values may ever be prefixed VITE_.
# Both are safe in the browser because every table is protected by row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SITE_URL=http://localhost:5173

# Never add the Supabase secret key, database password or access tokens here.
# They live only in Supabase (Edge Function runtime) and GitHub Actions secrets.
